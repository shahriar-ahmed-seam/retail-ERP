{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "outDir": "dist/renderer",
    "rootDir": "src",
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
